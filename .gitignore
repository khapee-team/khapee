node_modules/
dist/
.vercel/

# Working database and photos stay local; the committed snapshot seeds deploys.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.backup-*
data/uploads/
!data/snapshot.db

.DS_Store
.vercel
api/_bundle.mjs

# The key that signs login tokens. Never committed.
data/.session-secret
# The push keypair. A subscription is bound to the public half, so this must
# survive restarts — but it is a private key and never belongs in the repo.
data/.vapid.json
website/node_modules
website/dist

# Vercel project link (machine-local)
.vercel
website-v2/node_modules
website-v2/dist

# Server settings for deploy/ — secrets, never committed.
deploy/.env
# The live database when backups are on (scripts/start.sh) and the backup tool.
data/live/
bin/

# Petpooja sandbox credentials, kept out of the repo. The three tokens from
# their Configuration page go here so the certification script can read them
# without anyone pasting them into a chat, a commit or a shell history.
.env.petpooja
.env.local
